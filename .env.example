# ── Scrappy Environment Variables ──────────────────────────────
# Copy this to .env and fill in your values

# Security
PROXY_SECRET=generate-a-long-random-string-here

# Hysteria2 node hostnames (your VPS IPs or domains)
HYSTERIA_US_HOST=us1.yourdomain.com
HYSTERIA_EU_HOST=eu1.yourdomain.com
HYSTERIA_ASIA_HOST=sg1.yourdomain.com

# Hysteria2 ports (defaults fine unless you changed them)
HYSTERIA_US_SOCKS5_PORT=1080
HYSTERIA_US_HTTP_PORT=8080
HYSTERIA_EU_SOCKS5_PORT=1080
HYSTERIA_EU_HTTP_PORT=8080
HYSTERIA_ASIA_SOCKS5_PORT=1080
HYSTERIA_ASIA_HTTP_PORT=8080

# Redis (default is fine for Docker Compose)
REDIS_URL=redis://redis:6379

# CloakBrowser concurrency (tune to RAM: each instance ~300MB)
# 5 = ~1.5GB RAM used
MAX_CONCURRENT_BROWSERS=5

# Stripe (for billing integration)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
